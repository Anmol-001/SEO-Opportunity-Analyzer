# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Public deployment origin used for canonical social metadata
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local vertical-slice mode. Keep `fixture` until the live research pipeline is connected.
ANALYSIS_MODE="fixture"

# AI synthesis
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Primary SEO provider
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# SERP fallback
SERPER_API_KEY=""

# Server-configured completion webhook
WEBHOOK_URL=""

# Infrastructure smoke test (never expose these values to the browser)
ENABLE_INFRA_SMOKE="false"
SMOKE_TEST_TOKEN="replace-with-a-long-random-value"

# Used to hash request fingerprints for basic submission throttling
RATE_LIMIT_SALT="replace-with-a-long-random-value"
