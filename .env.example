# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Public deployment origin used for canonical social metadata
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Use `fixture` for partial local configuration or `live` when every readiness check passes.
ANALYSIS_MODE="fixture"

# AI synthesis
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# Primary SEO provider
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# SERP fallback
SERPER_API_KEY=""

# Server-configured completion webhook
WEBHOOK_URL=""
# Optional HMAC-SHA256 signing secret for webhook verification
WEBHOOK_SECRET=""

# Infrastructure smoke test (never expose these values to the browser)
ENABLE_INFRA_SMOKE="false"
SMOKE_TEST_TOKEN="replace-with-a-long-random-value"

# At least 32 random characters; required in production and live mode.
# Used to hash request fingerprints for basic submission throttling.
RATE_LIMIT_SALT="replace-with-a-long-random-value"
